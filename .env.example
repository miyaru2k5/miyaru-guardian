# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase service role (server-only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Cloudflare R2 (server-only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
NEXT_PUBLIC_R2_DOMAIN=pub-xxxx.r2.dev

# Website
NEXT_PUBLIC_WEBSITE_URL=https://admin.miyaru.online
NEXT_PUBLIC_WEBSITE_DOMAIN=admin.miyaru.online
NEXT_PUBLIC_WEBSITE_TITLE=Admin Việt Nam
NEXT_PUBLIC_SITE_URL=https://admin.miyaru.online
